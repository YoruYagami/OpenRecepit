<?xml version="1.0" encoding="utf-8"?>
<!-- Android <= 11 full-backup rules. Never consulted while allowBackup=false
     (the platform doesn't parse this file when backup is off); kept and
     referenced by the manifest purely as a deny-all guard in case the flag is
     ever re-enabled. Domain-wide excludes: immune to the path-typo bug class
     that made the previous app_webview rule a no-op. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
