# Copy to android/keystore.properties (gitignored) and fill in to sign release builds.
# Generate a keystore once:
#   keytool -genkey -v -keystore release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# Then point storeFile at it (path relative to the android/ directory).
storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
